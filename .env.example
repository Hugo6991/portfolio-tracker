CRON_SECRET=
DEBANK_ACCESS_KEY=
DEBANK_BASE_URL=https://pro-openapi.debank.com
# Optional comma-separated exact chain:contract approvals. Symbols are never accepted here.
DEBANK_TOKEN_ALLOWLIST=

BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

HTX_API_KEY=
HTX_API_SECRET=

GATE_API_KEY=
GATE_API_SECRET=

# Required server-only storage for portfolio reads, sync leases, and history.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORTFOLIO_SNAPSHOT_TTL_SECONDS=1200
PORTFOLIO_SOURCE_LKG_MAX_AGE_SECONDS=86400
DEBANK_SOURCE_LKG_MAX_AGE_SECONDS=259200
PORTFOLIO_ACCESS_PASSWORD=
# Independent read only dashboard access. Keep both values distinct from the owner password.
PORTFOLIO_VIEWER_PASSWORD=
PORTFOLIO_VIEWER_SESSION_SECRET=
AGENT_PORTFOLIO_EXPOSE_TOTAL=false
AGENT_FINANCE_API_TOKEN_SHA256=
PORTFOLIO_WALLET_CONCURRENCY=2

# Daily briefs use Vercel AI Gateway + OIDC automatically on Vercel.
# Set these only to override the default Gateway or model.
LLM_DAILY_REPORT_ENABLED=false
LLM_REPORT_API_URL=
LLM_REPORT_API_KEY=
LLM_REPORT_MODEL=openai/gpt-5.4-mini
PUBLIC_ASSISTANT_LLM_ENABLED=false

# Public read-only trading snapshot upstream. Never put signer or provider secrets here.
TRADING_WORKER_BASE_URL=https://shadow-worker-production.up.railway.app
